<div class="container">
  <h2 class="my-4 fw-bold">ショッピングカート</h2>

  <%= link_to "カートを空にする", destroy_all_cart_items_path,
            method: :delete,
            data: { confirm: "カートを空にしますか？" },
            class: "btn btn-outline-danger mb-3" %>

  <% if @cart_items.present? %>
    <table class="table align-middle">
      <thead class="table-light">
        <tr>
          <th>商品名</th>
          <th>単価（税込）</th>
          <th>数量</th>
          <th>小計</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @cart_items.each do |cart_item| %>
          <tr>
            <td><%= cart_item.item.name %></td>

            <td>
              <%= number_to_currency(cart_item.item.with_tax_price, unit: "¥", format: "%u%n", precision: 0) %>
            </td>

            <td>
              <%= form_with model: cart_item,
                            url: cart_item_path(cart_item),
                            method: :patch,
                            local: true,
                            class: "d-flex" do |f| %>
                <%= f.select :amount, (1..10), {}, class: "form-select form-select-sm me-2" %>
                <%= f.submit "変更", class: "btn btn-sm btn-outline-primary" %>
              <% end %>
            </td>

            <td>
              <%= number_to_currency(cart_item.item.with_tax_price * cart_item.amount, unit: "¥", format: "%u%n", precision: 0) %>
            </td>

            <td>
              <%= link_to "削除", cart_item_path(cart_item),
                          method: :delete,
                          data: { confirm: "削除しますか？" },
                          class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="text-end fw-bold fs-5">
      合計：<%= number_to_currency(@total, unit: "¥", format: "%u%n", precision: 0) %>
    </div>

    <div class="mt-4 d-flex justify-content-between">
      <%= link_to "買い物を続ける", items_path, class: "btn btn-outline-secondary" %>
      <%= link_to "情報入力に進む", new_order_path, class: "btn btn-success" %>
    </div>

  <% else %>
    <p>カートは空です。</p>
    <%= link_to "商品を見る", items_path, class: "btn btn-warning" %>
  <% end %>

</div>
