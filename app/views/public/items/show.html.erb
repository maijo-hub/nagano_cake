<div class="container mt-5">
  <div class="row align-items-center pastel-card shadow-sm p-4 rounded-4">
    <div class="col-md-5 text-center">
      <% if @item.image.attached? %>
        <%= image_tag @item.image, class: "img-fluid rounded-4 shadow-sm pastel-img" %>
      <% else %>
        <%= image_tag 'no_image.jpg', class: "img-fluid rounded-4 shadow-sm pastel-img" %>
      <% end %>
    </div>

    <div class="col-md-7 mt-4 mt-md-0">
      <h2 class="fw-bold text-pink mb-3">
        <i class="fa-solid fa-cake-candles me-2"></i>
        <%= @item.name %>
      </h2>

      <p class="text-muted mb-4"><%= @item.introduction %></p>

      <p class="fs-4 fw-bold text-pink">
        <%= number_to_currency(@item.add_tax_price, unit: "¥", format: "%u%n", precision: 0) %>
        <span class="fs-6 text-muted">(税込)</span>
      </p>

      <div class="mt-3">
        <%= form_with model: [@item, @cart_item || CartItem.new], url: cart_items_path, method: :post, local: true do |f| %>
          <div class="d-flex align-items-center flex-wrap">
            <%= f.label :amount, "個数選択", class: "me-2 fw-semibold" %>
            <%= f.select :amount, options_for_select((1..10).map { |n| [n, n] }), {}, class: "form-select pastel-select me-3 mb-2" %>
            <%= f.hidden_field :item_id, value: @item.id %>
            <%= f.submit "カートに入れる", class: "btn btn-pastel-green shadow-sm mb-2" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

