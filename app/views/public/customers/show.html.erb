<div class="container mt-4">
  <h2 class="mb-4">マイページ</h2>

  <!-- 登録情報 -->
  <div class="card mb-4 shadow-sm rounded-3 p-3">
    <h4 class="mb-3">登録情報</h4>
    <table class="table">
      <tr>
        <th>氏名</th>
        <td><%= @customer.last_name %> <%= @customer.first_name %></td>
      </tr>
      <tr>
        <th>カナ</th>
        <td><%= @customer.last_name_kana %> <%= @customer.first_name_kana %></td>
      </tr>
      <tr>
        <th>郵便番号</th>
        <td><%= @customer.postal_code %></td>
      </tr>
      <tr>
        <th>住所</th>
        <td><%= @customer.address %></td>
      </tr>
      <tr>
        <th>電話番号</th>
        <td><%= @customer.telephone_number %></td>
      </tr>
      <tr>
        <th>メールアドレス</th>
        <td><%= @customer.email %></td>
      </tr>
    </table>

    <%= link_to "登録情報を編集する", information_edit_path, class: "btn btn-outline-primary" %>
  </div>

  <!-- 注文履歴 -->
  <div class="card shadow-sm rounded-3 p-3">
    <h4 class="mb-3">注文履歴</h4>
    <%= link_to "一覧を見る", orders_path, class: "btn btn-outline-secondary" %>
  </div>
</div>
