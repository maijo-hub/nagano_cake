<div class="container mt-4">
  <h2>注文履歴一覧</h2>

  <% if @orders.present? %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>注文ID</th>
          <th>顧客名</th>
          <th>注文日</th>
          <th>合計金額</th>
          <th>ステータス</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td><%= order.created_at.strftime("%Y/%m/%d") %></td>
            <td><%= CartItem.where(customer_id: order.customer_id).sum(:amount) %></td>
            <td><%= order.total_payment %></td>
            <td><%= link_to "詳細", order_path(order) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>注文データがありません。</p>
  <% end %>
</div>
