<div class="container mt-4">

  <h2 class="admin-title">
    <i class="fa-solid fa-receipt icon-blue"></i>
    注文履歴詳細
  </h2>

  <!-- 注文情報 -->
  <div class="card admin-card mb-4">
    <div class="card-body">
      <p><strong>購入者：</strong>
        <%= @order.customer.full_name %>
      </p>
      <p><strong>注文日：</strong>
        <%= l(@order.created_at, format: :short) %>
      </p>
      <p><strong>配送先：</strong>
        <%= @order.address %>
      </p>
      <p><strong>支払方法：</strong>
        <%= @order.payment_method_i18n %>
      </p>
    </div>
  </div>

  <!-- 商品明細 -->
  <div class="card admin-card">
    <div class="card-body">
      <table class="table admin-table text-center align-middle">
        <thead>
          <tr>
            <th>商品名</th>
            <th>単価（税込）</th>
            <th>数量</th>
            <th>小計</th>
          </tr>
        </thead>

        <tbody>
          <% @cart_items.each do |ci| %>
            <tr>
              <td><%= ci.item.name %></td>
              <td>
                <%= number_to_currency(ci.item.price, unit: "¥", precision: 0) %>
              </td>
              <td><%= ci.amount %></td>
              <td>
                <%= number_to_currency(ci.item.price * ci.amount, unit: "¥", precision: 0) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="mt-4 text-end">
        <p>
          <strong>商品合計：</strong>
          <%= number_to_currency(@order.total_payment - @order.shipping_cost, unit: "¥", precision: 0) %>
        </p>
        <p>
          <strong>送料：</strong>
          <%= number_to_currency(@order.shipping_cost, unit: "¥", precision: 0) %>
        </p>
        <p class="fw-bold fs-5">
          請求金額合計：
          <%= number_to_currency(@order.total_payment, unit: "¥", precision: 0) %>
        </p>
      </div>
    </div>
  </div>

</div>
