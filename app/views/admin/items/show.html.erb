<div class="admin-content">
  <div class="container mt-4">
    <h2 class="mb-4">商品詳細</h2>

    <div class="row">
      <!-- 左側：画像 -->
      <div class="col-md-5 text-center">
        <% if @item.image.attached? %>
          <%= image_tag @item.image, class: "admin-item-image img-fluid rounded shadow-sm" %>
        <% else %>
          <%= image_tag "no_image.jpg", size: "300x300", class: "admin-item-image img-fluid rounded shadow-sm" %>
        <% end %>
      </div>
    

      <!-- 右側：詳細情報 -->
      <div class="col-md-7">
        <table class="table table-borderless admin-show-table">
          <tr>
            <th>商品名</th>
            <td><%= @item.name %></td>
          </tr>
          <tr>
            <th>商品説明</th>
            <td><%= @item.introduction %></td>
          </tr>
          <tr>
            <th>税抜価格</th>
            <td><%= number_to_currency(@item.price, unit: "¥", precision: 0, format: "%u%n") %></td>
          </tr>
          <tr>
            <th>税込価格</th>
            <td>
              <% tax_price = (@item.price * 1.1).floor %>
              <%= number_to_currency(tax_price, unit: "¥", precision: 0, format: "%u%n") %>
            </td>
          </tr>
          <tr>
            <th>販売ステータス</th>
            <td>
              <% if @item.is_active? %>
                <span class="text-success fw-bold">販売中</span>
              <% else %>
                <span class="text-danger fw-bold">販売停止中</span>
              <% end %>
            </td>
          </tr>
        </table>

        <%= link_to "編集する", edit_admin_item_path(@item), class: "btn btn-outline-primary px-4 mt-3" %>
      </div>
    </div>
  </div>
</div>
