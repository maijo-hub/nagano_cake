<div class="container mt-4 admin-show-container">
  <h2 class="mb-4">商品詳細</h2>

  <div class="row g-4">
    <!-- 左側：画像 -->
    <div class="col-md-5 text-center">
      <div class="admin-item-image-box p-3 rounded shadow-sm bg-white">
        <% if @item.image.attached? %>
          <%= image_tag @item.image.variant(resize_to_limit: [350, 350]), class: "img-fluid rounded" %>
        <% else %>
          <%= image_tag "no_image.jpg", size: "350x350", class: "img-fluid rounded" %>
        <% end %>
      </div>
    </div>

    <!-- 右側：詳細情報 -->
    <div class="col-md-7">
      <table class="table admin-table shadow-sm">
        <tr>
          <th class="admin-th">商品名</th>
          <td class="admin-td"><%= @item.name %></td>
        </tr>

        <tr>
          <th class="admin-th">商品説明</th>
          <td class="admin-td"><%= @item.introduction %></td>
        </tr>

        <tr>
          <th class="admin-th">税抜価格</th>
          <td class="admin-td price">
            <%= number_to_currency(@item.price, unit: "¥", precision: 0) %>
          </td>
        </tr>

        <tr>
          <th class="admin-th">税込価格</th>
          <td class="admin-td price">
            <% tax_price = (@item.price * 1.1).floor %>
            <%= number_to_currency(tax_price, unit: "¥", precision: 0) %>
          </td>
        </tr>

        <tr>
          <th class="admin-th">販売ステータス</th>
          <td class="admin-td">
            <% if @item.is_active? %>
              <span class="text-success fw-bold">販売中</span>
            <% else %>
              <span class="text-danger fw-bold">販売停止中</span>
            <% end %>
          </td>
        </tr>
      </table>

      <%= link_to "編集する", edit_admin_item_path(@item),
          class: "btn admin-edit-btn px-4 mt-3" %>
    </div>
  </div>
</div>
