<div class="container mt-4">
  <h2 class="mb-4">商品新規登録</h2>

  <%= form_with model: @item, url: admin_items_path, local: true, class: "needs-validation" do |f| %>
    <!-- 商品名 -->
    <div class="form-group mb-3">
      <%= f.label :name, "商品名", class: "form-label fw-bold" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <!-- 商品説明 -->
    <div class="form-group mb-3">
      <%= f.label :introduction, "商品説明", class: "form-label fw-bold" %>
      <%= f.text_area :introduction, rows: 3, class: "form-control" %>
    </div>

    <!-- 税抜価格 -->
    <div class="form-group mb-3">
      <%= f.label :price, "税抜価格 (円)", class: "form-label fw-bold" %>
      <%= f.number_field :price, class: "form-control", min: 0, step: 10 %>
    </div>

    <!-- 商品画像 -->
    <div class="form-group mb-3">
      <%= f.label :image, "商品画像" %><br>
      <%= f.file_field :image, class: "form-control-file" %>
    </div>


    <!-- 販売ステータス -->
    <div class="form-group mb-4">
      <%= f.label :is_active, "販売ステータス", class: "form-label fw-bold d-block" %>
      <div class="form-check form-check-inline">
        <%= f.radio_button :is_active, true, checked: true, id: "active_true", class: "form-check-input" %>
        <%= f.label :is_active, "販売中", value: true, class: "form-check-label" %>
      </div>
      <div class="form-check form-check-inline">
        <%= f.radio_button :is_active, false, id: "active_false", class: "form-check-input" %>
        <%= f.label :is_active, "販売停止中", value: false, class: "form-check-label" %>
      </div>
    </div>

    <%= f.submit "新規登録", class: "btn btn-primary px-4" %>
  <% end %>
</div>
