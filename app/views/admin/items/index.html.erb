<div class="container mt-4">
  <h2 class="mb-4">商品一覧</h2>

  <table class="table table-striped align-middle">
    <thead class="table-light">
      <tr>
        <th>商品ID</th>
        <th>商品画像</th>
        <th>商品名</th>
        <th>価格（税抜）</th>
        <th>販売ステータス</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= item.id %></td>

          <td>
            <% if item.image.attached? %>
              <%= image_tag item.image.variant(resize_to_limit: [80, 80]), class: "img-thumbnail" %>
            <% else %>
              <%= image_tag "no_image.jpg", size: "80x80", class: "img-thumbnail" %>
            <% end %>
          </td>

          <td><%= link_to item.name, admin_item_path(item), class: "text-decoration-none fw-bold" %></td>
          <td><%= number_to_currency(item.price, unit: "¥", precision: 0) %></td>

          <td>
            <% if item.is_active? %>
              <span class="badge bg-success">販売中</span>
            <% else %>
              <span class="badge bg-secondary">販売停止中</span>
            <% end %>
          </td>

          <td>
            <%= link_to "編集", edit_admin_item_path(item), class: "btn btn-outline-primary btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
