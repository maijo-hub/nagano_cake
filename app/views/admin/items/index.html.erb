<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold text-primary"><i class="fa-solid fa-cake-candles"></i> 商品一覧</h2>
    <%= link_to new_admin_item_path, class: "btn btn-pink fw-bold" do %>
      <i class="fa-solid fa-plus"></i> 新規登録
    <% end %>
  </div>

  <table class="table table-striped table-hover align-middle shadow rounded-3">
    <thead class="table-light">
      <tr>
        <th class="text-center">商品ID <i class="fa-solid fa-hashtag"></i></th>
        <th class="text-center">商品画像 <i class="fa-solid fa-image"></i></th>
        <th class="text-center">商品名 <i class="fa-solid fa-bag-shopping"></i></th>
        <th class="text-center">価格（税抜） <i class="fa-solid fa-yen-sign"></i></th>
        <th class="text-center">販売ステータス <i class="fa-solid fa-circle-info"></i></th>
        <th class="text-center">操作 <i class="fa-solid fa-gear"></i></th>
      </tr>
    </thead>

    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td class="text-center fw-bold text-secondary"><%= item.id %></td>

          <td class="text-center">
            <% if item.image.attached? %>
              <%= image_tag item.image.variant(resize_to_limit: [80, 80]), class: "img-thumbnail rounded" %>
            <% else %>
              <%= image_tag "no_image.jpg", size: "80x80", class: "img-thumbnail rounded" %>
            <% end %>
          </td>

          <td>
            <%= link_to admin_item_path(item), class: "text-decoration-none fw-bold text-dark" do %>
              <i class="fa-solid fa-star text-warning"></i> <%= item.name %>
            <% end %>
          </td>

          <td class="text-center text-success fw-bold">
            <%= number_to_currency(item.price, unit: "¥", precision: 0) %>
          </td>

          <td class="text-center">
            <% if item.is_active? %>
              <span class="badge bg-success rounded-pill">
                <i class="fa-solid fa-check-circle"></i> 販売中
              </span>
            <% else %>
              <span class="badge bg-secondary rounded-pill">
                <i class="fa-solid fa-x-circle"></i> 販売停止中
              </span>
            <% end %>
          </td>

          <td class="text-center">
            <%= link_to edit_admin_item_path(item), class: "btn btn-outline-primary btn-sm rounded-pill me-1" do %>
              <i class="fa-solid fa-pen-to-square"></i> 編集
            <% end %>
            <%= link_to admin_item_path(item), method: :delete, data: { confirm: "削除しますか？" }, class: "btn btn-outline-danger btn-sm rounded-pill" do %>
              <i class="fa-solid fa-trash"></i> 削除
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @items %>
  </div>
</div>

<style>
  .btn-pink {
    background-color: #ff85c0;
    color: white;
  }
  .btn-pink:hover {
    background-color: #ff6bb0;
    color: white;
  }
  .table-striped > tbody > tr:nth-of-type(odd) {
    background-color: #fff0f5; /* パステルピンク */
  }
</style>
