<h2>商品一覧</h2>
<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>商品名</th>
      <th>価格（税抜）</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @items.each do |item| %>
      <tr>
        <td><%= item.id %></td>
        <td><%= item.name %></td>
        <td><%= item.price %>円</td>
        <td><%= link_to "詳細", admin_item_path(item), class: "btn btn-sm btn-primary" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "新規商品登録", new_admin_item_path, class: "btn btn-success" %>
