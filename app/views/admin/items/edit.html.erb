<div class="container mt-5">
  <h2 class="mb-4">商品編集</h2>

  <%= form_with model: @item, url: admin_item_path(@item), method: :patch, local: true do |f| %>
    <div class="row">
      <!-- 左側：商品画像 -->
      <div class="col-md-5 text-center mb-4">
        <% if @item.image.attached? %>
          <%= image_tag @item.image, class: "img-fluid rounded shadow-sm", style: "max-height: 300px;" %>
        <% else %>
          <p class="text-muted">画像なし</p>
        <% end %>
        <div class="mt-2">
          <%= f.label :image, "商品画像を変更", class: "form-label fw-bold" %><br>
          <%= f.file_field :image, class: "" %>
        </div>
      </div>

      <!-- 右側：商品情報 -->
      <div class="col-md-7">
        <div class="mb-3">
          <%= f.label :name, "商品名", class: "form-label fw-bold" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :introduction, "商品説明", class: "form-label fw-bold" %>
          <%= f.text_area :introduction, class: "form-control", rows: 5 %>
        </div>

        <div class="mb-3">
          <%= f.label :price, "税抜価格", class: "form-label fw-bold" %>
          <div class="input-group">
            <%= f.number_field :price, class: "form-control", min: 0 %>
            <span class="input-group-text">円</span>
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :is_active, "販売ステータス", class: "form-label fw-bold" %><br>
          <div class="form-check form-check-inline">
            <%= f.radio_button :is_active, true, class: "form-check-input" %>
            <%= f.label :is_active, "販売中", value: true, class: "form-check-label" %>
          </div>
          <div class="form-check form-check-inline">
            <%= f.radio_button :is_active, false, class: "form-check-input" %>
            <%= f.label :is_active, "販売停止中", value: false, class: "form-check-label" %>
          </div>
        </div>

        <div class="text-end">
          <%= f.submit "変更を保存", class: "btn btn-outline-success" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
