<div class="admin-content">
  <div class="container mt-5 admin-edit-container">
    <h2 class="mb-4">商品編集</h2>

    <%= form_with model: @item, url: admin_item_path(@item), method: :patch, local: true do |f| %>
      <div class="row">

        <!-- 左側：商品画像 -->
        <div class="col-md-5 mb-4 text-center">
          <div class="admin-item-image-box p-3">
            <% if @item.image.attached? %>
              <%= image_tag @item.image, class: "admin-item-image img-fluid rounded shadow-sm" %>
            <% else %>
              <%= image_tag "no_image.jpg", size: "300x300", class: "admin-item-image img-fluid rounded shadow-sm" %>
            <% end %>
          </div>

          <div class="mt-3">
            <%= f.label :image, "商品画像を変更", class: "form-label fw-bold" %><br>
            <%= f.file_field :image, class: "form-control" %>
          </div>
        </div>

        <!-- 右側：商品情報 -->
        <div class="col-md-7">
          <div class="admin-edit-card p-4 rounded shadow-sm">

            <div class="mb-3">
              <%= f.label :name, "商品名", class: "admin-form-label" %>
              <%= f.text_field :name, class: "form-control admin-form-input" %>
            </div>

            <div class="mb-3">
              <%= f.label :introduction, "商品説明", class: "admin-form-label" %>
              <%= f.text_area :introduction, class: "form-control admin-form-input", rows: 5 %>
            </div>

            <div class="mb-3">
              <%= f.label :price, "税抜価格", class: "admin-form-label" %>
              <div class="input-group admin-form-input">
                <%= f.number_field :price, class: "form-control", min: 0 %>
                <span class="input-group-text">円</span>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :is_active, "販売ステータス", class: "admin-form-label" %><br>

              <div class="form-check form-check-inline">
                <%= f.radio_button :is_active, true, class: "form-check-input" %>
                <label class="form-check-label">販売中</label>
              </div>

              <div class="form-check form-check-inline">
                <%= f.radio_button :is_active, false, class: "form-check-input" %>
                <label class="form-check-label">販売停止中</label>
              </div>
            </div>

            <div class="text-end">
              <%= f.submit "変更を保存", class: "btn admin-edit-btn px-4" %>
            </div>

          </div>
        </div>

      </div>
    <% end %>
  </div>
</div>
