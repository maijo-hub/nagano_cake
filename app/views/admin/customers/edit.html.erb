<div class="container py-4">
  <h2 class="mb-4 text-pink fw-bold d-flex align-items-center">
    <i class="fa-solid fa-user-pen me-2"></i> 会員情報編集
  </h2>

  <%= form_with model: @customer, url: admin_customer_path(@customer), method: :patch, local: true, class: "shadow-sm bg-white p-4 rounded-3" do |f| %>
    <table class="table align-middle">
      <tbody>
        <tr>
          <th class="w-25 text-secondary">会員ID</th>
          <td><%= @customer.id %></td>
        </tr>
        <tr>
          <th class="text-secondary">氏名</th>
          <td class="d-flex gap-2">
            <%= f.text_field :last_name, class: "form-control pastel-input", placeholder: "姓" %>
            <%= f.text_field :first_name, class: "form-control pastel-input", placeholder: "名" %>
          </td>
        </tr>
        <tr>
          <th class="text-secondary">フリガナ</th>
          <td class="d-flex gap-2">
            <%= f.text_field :last_name_kana, class: "form-control pastel-input", placeholder: "セイ" %>
            <%= f.text_field :first_name_kana, class: "form-control pastel-input", placeholder: "メイ" %>
          </td>
        </tr>
        <tr>
          <th class="text-secondary">郵便番号</th>
          <td>
            <div class="input-group">
              <span class="input-group-text bg-light border-0"><i class="fa-solid fa-location-dot text-pink"></i></span>
              <%= f.text_field :postal_code, class: "form-control pastel-input", placeholder: "例：1500041" %>
            </div>
          </td>
        </tr>
        <tr>
          <th class="text-secondary">住所</th>
          <td>
            <%= f.text_field :address, class: "form-control pastel-input", placeholder: "東京都渋谷区神南1-19-11 ..." %>
          </td>
        </tr>
        <tr>
          <th class="text-secondary">電話番号</th>
          <td>
            <div class="input-group">
              <span class="input-group-text bg-light border-0"><i class="fa-solid fa-phone text-pink"></i></span>
              <%= f.text_field :telephone_number, class: "form-control pastel-input", placeholder: "例：0368694700" %>
            </div>
          </td>
        </tr>
        <tr>
          <th class="text-secondary">メールアドレス</th>
          <td>
            <div class="input-group">
              <span class="input-group-text bg-light border-0"><i class="fa-solid fa-envelope text-pink"></i></span>
              <%= f.email_field :email, class: "form-control pastel-input", placeholder: "example@example.com" %>
            </div>
          </td>
        </tr>
        <tr>
          <th class="text-secondary">会員ステータス</th>
          <td>
            <div class="form-check form-check-inline">
              <%= f.radio_button :is_active, true, id: "active_true", class: "form-check-input" %>
              <%= f.label :is_active, "有効", for: "active_true", class: "form-check-label fw-bold text-success" %>
            </div>
            <div class="form-check form-check-inline">
              <%= f.radio_button :is_active, false, id: "active_false", class: "form-check-input" %>
              <%= f.label :is_active, "退会", for: "active_false", class: "form-check-label fw-bold text-muted" %>
            </div>
          </td>
        </tr>
      </tbody>
    </table>

    <div class="text-center mt-4">
      <%= f.submit "変更を保存", class: "btn btn-pastel btn-lg d-flex align-items-center mx-auto justify-content-center" %>
    </div>
  <% end %>
</div>

