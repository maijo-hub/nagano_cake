<div class="container py-4">
  <h2 class="admin-title">
    <i class="fa-solid fa-user-pen"></i> 会員情報編集
  </h2>

  <%= form_with model: @customer, url: admin_customer_path(@customer), method: :patch, local: true, class: "shadow-sm bg-white p-4 rounded-3" do |f| %>

    <table class="table admin-table align-middle">
      <tbody>
        <tr>
          <th>会員ID</th>
          <td><%= @customer.id %></td>
        </tr>

        <tr>
          <th>氏名</th>
          <td class="d-flex gap-2">
            <%= f.text_field :last_name, class: "form-control admin-input", placeholder: "姓" %>
            <%= f.text_field :first_name, class: "form-control admin-input", placeholder: "名" %>
          </td>
        </tr>

        <tr>
          <th>フリガナ</th>
          <td class="d-flex gap-2">
            <%= f.text_field :last_name_kana, class: "form-control admin-input", placeholder: "セイ" %>
            <%= f.text_field :first_name_kana, class: "form-control admin-input", placeholder: "メイ" %>
          </td>
        </tr>

        <tr>
          <th>郵便番号</th>
          <td>
            <div class="input-group">
              <span class="input-group-text bg-light border-0">
                <i class="fa-solid fa-location-dot text-primary"></i>
              </span>
              <%= f.text_field :postal_code, class: "form-control admin-input", placeholder: "例：1500041" %>
            </div>
          </td>
        </tr>

        <tr>
          <th>住所</th>
          <td>
            <%= f.text_field :address, class: "form-control admin-input", placeholder: "東京都渋谷区神南1-19-11 ..." %>
          </td>
        </tr>

        <tr>
          <th>電話番号</th>
          <td>
            <div class="input-group">
              <span class="input-group-text bg-light border-0">
                <i class="fa-solid fa-phone text-primary"></i>
              </span>
              <%= f.text_field :telephone_number, class: "form-control admin-input", placeholder: "例：0368694700" %>
            </div>
          </td>
        </tr>

        <tr>
          <th>メールアドレス</th>
          <td>
            <div class="input-group">
              <span class="input-group-text bg-light border-0">
                <i class="fa-solid fa-envelope text-primary"></i>
              </span>
              <%= f.email_field :email, class: "form-control admin-input", placeholder: "example@example.com" %>
            </div>
          </td>
        </tr>

        <tr>
          <th>会員ステータス</th>
          <td>
            <div class="status-toggle text-center mt-3">
              <%= f.radio_button :is_active, true, id: "active_true", class: "status-radio" %>
              <%= f.label :active_true, "有効", class: "status-btn status-active-btn" %>
            
              <%= f.radio_button :is_active, false, id: "active_false", class: "status-radio" %>
              <%= f.label :active_false, "退会", class: "status-btn status-inactive-btn" %>
            </div>
          </td>
        </tr>

      </tbody>
    </table>

    <div class="text-center mt-4">
      <%= f.submit "変更を保存", class: "btn-save" %>
    </div>
  <% end %>
</div>
