<div class="container py-4">
  <h2 class="mb-4 text-pink fw-bold">
    <i class="fa-solid fa-user me-2"></i>
    <%= @customer.last_name %><%= @customer.first_name %> さんの会員詳細
  </h2>

  <table class="table shadow-sm bg-white rounded-3 align-middle">
    <tbody>
      <tr>
        <th class="text-secondary w-25">会員ID</th>
        <td><%= @customer.id %></td>
      </tr>
      <tr>
        <th class="text-secondary">氏名</th>
        <td><%= @customer.last_name %> <%= @customer.first_name %></td>
      </tr>
      <tr>
        <th class="text-secondary">フリガナ</th>
        <td><%= @customer.last_name_kana %> <%= @customer.first_name_kana %></td>
      </tr>
      <tr>
        <th class="text-secondary">郵便番号</th>
        <td><%= @customer.postal_code %></td>
      </tr>
      <tr>
        <th class="text-secondary">住所</th>
        <td><%= @customer.address %></td>
      </tr>
      <tr>
        <th class="text-secondary">電話番号</th>
        <td><%= @customer.telephone_number %></td>
      </tr>
      <tr>
        <th class="text-secondary">メールアドレス</th>
        <td><%= @customer.email %></td>
      </tr>
      <tr>
        <th class="text-secondary">会員ステータス</th>
        <td>
          <% if @customer.is_active? %>
            <span class="badge bg-success px-3 py-2">有効</span>
          <% else %>
            <span class="badge bg-secondary px-3 py-2">退会</span>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>

  <div class="mt-4 d-flex gap-2">
    <%= link_to edit_admin_customer_path(@customer), class: "btn btn-pastel d-flex align-items-center" do %>
      <i class="fa-solid fa-pen-to-square me-1"></i> 編集する
    <% end %>

    <%= link_to admin_orders_path(customer_id: @customer.id), class: "btn btn-outline-pink d-flex align-items-center" do %>
      <i class="fa-solid fa-clipboard-list me-1"></i> 注文履歴一覧を見る
    <% end %>
  </div>
</div>

<style>
  .text-pink { color: #ff85c0; }

  .btn-pastel {
    background-color: #ffd6e8;
    color: #6b2a5c;
    border-radius: 50px;
    padding: 0.5rem 1rem;
    font-weight: 500;
    transition: 0.2s;
  }

  .btn-pastel:hover {
    background-color: #ffb3d2;
    color: white;
  }

  .btn-outline-pink {
    border: 2px solid #ff85c0;
    color: #ff85c0;
    border-radius: 50px;
    padding: 0.5rem 1rem;
    font-weight: 500;
    transition: 0.2s;
  }

  .btn-outline-pink:hover {
    background-color: #ff85c0;
    color: white;
  }

  th {
    background-color: #fff5f8;
    color: #6b2a5c;
  }

  td {
    color: #4a2a48;
  }
</style>
