<div class="admin-customer-show container py-4">

  <h2 class="admin-title mb-4">
    <i class="fa-solid fa-user me-2"></i>
    <%= @customer.last_name %><%= @customer.first_name %> さんの会員詳細
  </h2>

  <table class="admin-table table">
    <tbody>
      <tr>
        <th>会員ID</th>
        <td><%= @customer.id %></td>
      </tr>
      <tr>
        <th>氏名</th>
        <td><%= @customer.last_name %> <%= @customer.first_name %></td>
      </tr>
      <tr>
        <th>フリガナ</th>
        <td><%= @customer.last_name_kana %> <%= @customer.first_name_kana %></td>
      </tr>
      <tr>
        <th>郵便番号</th>
        <td><%= @customer.postal_code %></td>
      </tr>
      <tr>
        <th>住所</th>
        <td><%= @customer.address %></td>
      </tr>
      <tr>
        <th>電話番号</th>
        <td><%= @customer.telephone_number %></td>
      </tr>
      <tr>
        <th>メールアドレス</th>
        <td><%= @customer.email %></td>
      </tr>
      <tr>
        <th>会員ステータス</th>
        <td>
          <% if @customer.is_active? %>
            <span class="status-active">有効</span>
          <% else %>
            <span class="status-inactive">退会</span>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>

  <div class="admin-actions mt-4 d-flex gap-3">
    <%= link_to edit_admin_customer_path(@customer), class: "btn btn-main" do %>
      <i class="fa-solid fa-pen-to-square me-1"></i> 編集する
    <% end %>

    <%= link_to admin_customers_path, class: "btn btn-sub" do %>
      <i class="fa-solid fa-clipboard-list me-1"></i> 会員一覧に戻る
    <% end %>
  </div>
</div>
