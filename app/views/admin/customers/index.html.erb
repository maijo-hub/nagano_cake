<div class="container mt-4">

  <h2 class="admin-title mb-4">
    <i class="fa-solid fa-users icon-blue"></i>
    会員一覧
  </h2>

  <div class="table-responsive">
    <table class="table admin-table customer-table">
      <thead>
        <tr>
          <th>会員ID</th>
          <th>氏名</th>
          <th>メールアドレス</th>
          <th>ステータス</th>
        </tr>
      </thead>

      <tbody>
        <% @customers.each do |customer| %>
          <tr>
            <td><%= customer.id %></td>

            <td>
              <%= link_to admin_customer_path(customer),
                          class: "link-blue fw-bold d-flex align-items-center justify-content-center gap-1" do %>
                <i class="fa-solid fa-user icon-blue"></i>
                <%= customer.last_name %> <%= customer.first_name %>
              <% end %>
            </td>

            <td><%= customer.email %></td>

            <td>
              <% if customer.is_active? %>
                <span class="status-badge active">
                  <i class="fa-solid fa-circle-check me-1"></i> 有効
                </span>
              <% else %>
                <span class="status-badge inactive">
                  <i class="fa-solid fa-circle-xmark me-1"></i> 退会
                </span>
              <% end %>
            </td>

          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @customers %>
  </div>

</div>
