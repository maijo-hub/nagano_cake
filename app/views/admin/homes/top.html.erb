<div class="container mt-4">

  <h2 class="admin-title">
    <i class="fa-solid fa-clipboard-list icon-blue"></i>
    注文履歴一覧
  </h2>

  <table class="table admin-table">
    <thead>
      <tr>
        <th>購入日時</th>
        <th>購入者</th>
        <th>注文個数</th>
      </tr>
    </thead>

    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <!-- 注文詳細へのリンク（admin_order_path が存在する想定） -->
          <td>
            <%= link_to order.created_at.strftime("%Y-%m-%d %H:%M"),
                        (defined?(admin_order_path) ? admin_order_path(order) : "#"),
                        class: "link-blue text-decoration-none" %>
          </td>

          <td><%= order.customer&.full_name || "—" %></td>

          <!-- 注文個数：安全に取得（order_details または代替 assoc の有無で分岐） -->
          <td>
            <% qty = nil %>
            <% if order.respond_to?(:order_details) %>
              <%# order_details があれば合計を使う %>
              <% qty = order.order_details.sum(:amount) rescue nil %>
            <% elsif order.respond_to?(:order_items) %>
              <%# 別名の関連がある場合のフォールバック %>
              <% qty = order.order_items.sum(:quantity) rescue nil %>
            <% elsif order.respond_to?(:total_quantity) %>
              <%# メソッドで合計を保持している場合のフォールバック %>
              <% qty = order.total_quantity rescue nil %>
            <% end %>

            <%= qty.present? ? qty : "-" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @orders %>
  </div>
</div>
