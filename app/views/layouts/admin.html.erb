<!DOCTYPE html>
<html>
  <head>
    <title>NaganoCake</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- FontAwesome -->
    <script src="https://kit.fontawesome.com/18b80b8bde.js" crossorigin="anonymous"></script>

    <!-- CSS / JS -->
    <%= stylesheet_pack_tag 'admin', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'admin', 'data-turbolinks-track': 'reload' %>    

  </head>

  <body class="<%= controller_path.start_with?('admin/') ? 'admin-background' : '' %>">
    <%= render 'layouts/admin_header' %>
    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
