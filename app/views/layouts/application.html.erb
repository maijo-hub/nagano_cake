<!DOCTYPE html>
<html>
  <head>
    <title>NaganoCake</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- FontAwesome -->
    <script src="https://kit.fontawesome.com/18b80b8bde.js" crossorigin="anonymous"></script>

    <!-- CSS / JS -->
    <!-- CSS / JS -->
      <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
      <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>

  </head>

  <body class="<%= 'admin-background' if controller_path.start_with?('admin/') %>">

    <% if controller_path.start_with?('admin/') %>
      <!-- 管理者用ヘッダー -->
      <%= render 'layouts/admin_header' %>
    <% else %>
      <!-- 公開用ヘッダー -->
      <%= render 'layouts/public_header' %>
    <% end %>

    <!-- メインコンテンツ -->
    <main class="<%= controller_path.start_with?('admin/') ? 'admin-main' : 'public-main' %>">
      <%= yield %>
    </main>

    
  </body>
</html>
