<!-- app/views/layouts/_public_header.html.erb -->
<header class="navbar navbar-light bg-pink shadow-sm">
  <div class="container">
    <!-- 🍰 ロゴ -->
    <%= link_to root_path, class: "navbar-brand fw-bold", style: "color: #ffb6c1;" do %>
      <i class="fa-solid fa-cake-candles me-2" style="color: #ffb6c1;"></i>
      Nagano Cake
    <% end %>

    <nav class="ms-auto">
      <ul class="navbar-nav">

        <% if customer_signed_in? %>
          <!-- ✅ ログイン後 -->
          <li class="nav-item">
            <%= link_to "マイページ", mypage_customers_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "商品一覧", items_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "カート", cart_items_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "ログアウト", destroy_customer_session_path, method: :delete, class: "nav-link", data: { confirm: "ログアウトしますか？" } %>
          </li>

        <% else %>
          <!-- ✅ ログイン前 -->
          <li class="nav-item">
            <%= link_to "About", about_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "商品一覧", items_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "新規登録", new_customer_registration_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "ログイン", new_customer_session_path, class: "nav-link" %>
          </li>
        <% end %>

      </ul>
    </nav>
  </div>
</header>
